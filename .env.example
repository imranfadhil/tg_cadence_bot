# --- Application & Server (Single-Process Featherweight Mode) ---
APP_ENV=production
HOST=0.0.0.0
PORT=8000
MINI_APP_URL=http://localhost:8000

# --- SQLite WAL Database (Zero External Daemons) ---
DATABASE_URL=sqlite+aiosqlite:///./data/cadence.db

# --- Telegram Bot ---
# Get your token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=

# --- AI & Voice APIs (Zero Heavy Local Libraries) ---
# OpenRouter for LLM Structured Outputs & Multimodal Voice Transcription
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_AUDIO_MODEL=google/gemini-2.0-flash-001

# Optional: Groq Whisper API (whisper-large-v3-turbo) for ultra-fast voice transcription
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Default User Preferences ---
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
DEFAULT_MORNING_BRIEF=08:00
DEFAULT_EVENING_PULSE=21:00
