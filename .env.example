# --- Application & Server (Single-Process Featherweight Mode) ---
APP_ENV=production
HOST=0.0.0.0
PORT=8000
WEBAPP_PUBLIC_URL=https://cadence.yourdomain.com
MINI_APP_URL=http://localhost:8000

# --- Security: Bot & Mini App Access Passphrase / PIN ---
# Set a PIN or passphrase (e.g. 8492 or my-secret-phrase) to restrict access.
# Users must send this passphrase/PIN once in Telegram chat (or enter it in the Mini App) to unlock.
ACCESS_PASSPHRASE=cadence2026

# --- SQLite WAL Database (Zero External Daemons) ---
DATABASE_URL=sqlite+aiosqlite:///./data/cadence.db

# --- Telegram Configuration ---
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=

# --- Dual-Model LLM Configuration via OpenRouter ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_API_KEY=
MODEL_FAST=google/gemini-2.5-flash-lite
MODEL_SMART=google/gemini-2.5-flash

# --- Optional Groq Fallback for Ultra-Fast Whisper Transcription (if LLM is text-only) ---
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Default User Preferences ---
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur
DEFAULT_MORNING_BRIEF=08:00
DEFAULT_EVENING_PULSE=21:00
